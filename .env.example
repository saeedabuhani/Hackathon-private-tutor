# Copy this file to .env.local and fill in your own values. NEVER commit real keys.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# YouTube
YOUTUBE_API_KEY=

# YouTube region for search (optional, default IL)
# YOUTUBE_REGION=IL

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin-only route POST /api/ai-videos/add (send as header x-admin-key)
ADMIN_API_KEY=
